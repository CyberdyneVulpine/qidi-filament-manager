# Template. install.sh writes the installed unit to /etc/systemd/system/.
[Unit]
Description=On-printer filament catalog manager
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__USER__
Group=__GROUP__
WorkingDirectory=__DIR__
Environment=FILAMENT_MANAGER_PORT=__PORT__
ExecStart=__PYTHON__ __DIR__/server.py
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
